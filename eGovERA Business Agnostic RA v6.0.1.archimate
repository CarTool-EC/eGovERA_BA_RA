                <sourceConnection xsi:type="archimate:Connection" id="id-b66a52131ecc4704bdbaebbee3eb1a25" source="id-b662f8bf31dd42caafec27ab02ea8f13" target="id-3088ed738671432b82351cbcf2bb5c47" archimateRelationship="id-7778aad7e55f43799d6d6069f185326d"/>
