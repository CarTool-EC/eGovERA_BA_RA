            <child xsi:type="archimate:DiagramObject" id="id-7df7afc48ae243dcb5a95322818a5551" font="1|Segoe UI|9.0|3|WINDOWS|1|0|0|0|0|700|1|0|0|1|0|0|0|0|Segoe UI" textPosition="1" archimateElement="id-56e0d4768c73478dafb1413f59bd8e5f">
              <bounds x="2112" y="1224" width="250" height="75"/>
              <sourceConnection xsi:type="archimate:Connection" id="id-1419361e045948b6912b51dbaa4c09e2" source="id-7df7afc48ae243dcb5a95322818a5551" target="id-81919fdd08b74522a3d8ce6bf437e762" archimateRelationship="id-94b6be6ba9e245bda11c567b80dc27f1"/>
