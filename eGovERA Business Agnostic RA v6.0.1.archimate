    <element xsi:type="archimate:Requirement" name="Declaration on Digital Rights and Principles" id="id-637a1b7e35174a19937ce9e3ad4f2d4c">
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="dct:modified" value="2024-01-17"/>
      <property key="dct:title" value="Declaration on Digital Rights and Principles"/>
      <property key="dct:description" value="The European Declaration on Digital Rights and Principles for the Digital Decade is a document that outlines the fundamental rights and principles that should govern the digital sphere in Europe over the next ten years. It emphasizes the importance of protecting and promoting human rights, such as privacy, freedom of expression, and non-discrimination, in the digital age. The declaration also calls for the development of a human-centric approach to technology, ensuring that digital innovations serve the best interests of individuals and society as a whole. It aims to create a framework that fosters a fair, inclusive, and sustainable digital future for Europe."/>
      <property key="dct:source" value="https://digital-strategy.ec.europa.eu/en/library/declaration-european-digital-rights-and-principles"/>
      <property key="dct:identifier" value="https://digital-strategy.ec.europa.eu/en/library/declaration-european-digital-rights-and-principles"/>
