      <property key="dct:title" value="Data Integration Application Service"/>
      <property key="dct:type" value="egovera:DataIntegrationApplicationComponent"/>
      <property key="skos:definition" value="Data Integration ABB is an Application Component that implements the process of combining data from different sources or systems into a unified view, ensuring consistency, accuracy, and accessibility. It involves transforming and merging data from various formats, structures, and locations to provide a comprehensive and integrated data set."/>
      <property key="eira:definitionSource" value="Wikipedia"/>
